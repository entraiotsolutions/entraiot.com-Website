    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.2.3",
    "nodemailer": "^8.0.5",
    "postcss": "^8.5.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
